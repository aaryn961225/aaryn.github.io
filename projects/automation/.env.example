# Test target
# Portfolio default uses local mock page under demo-app/index.html.
# In a real company environment this can point to a staging/test URL.
TEST_BASE_URL=http://localhost:3000

# Phase 2 integration mode
# Current portfolio supports mock only. Do not put real API keys in this demo.
AI_REVIEW_MODE=mock
LLM_PROVIDER=mock
LLM_API_KEY=

# MCP / n8n placeholders
MCP_ENABLED=false
MCP_SERVER_URL=
N8N_WEBHOOK_URL=

# Safety boundary
ALLOW_SOURCE_CODE_ACCESS=false
ALLOW_DATABASE_ACCESS=false
ALLOW_PRODUCTION_ACCESS=false
